OPS_MYSQL_PASSWORD=ops_local_password
OPS_MYSQL_ROOT_PASSWORD=ops_local_root_password
OPS_REDIS_PASSWORD=ops_local_redis_password
OPS_DEPLOY_PASSWORD_HASH=
# Generate once with: openssl rand -base64 32
OPS_DEPLOY_CREDENTIAL_KEY=

# Used by the Go process, not Docker Compose itself.
OPS_MYSQL_DSN=ops:ops_local_password@tcp(127.0.0.1:13306)/ops_deploy?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
