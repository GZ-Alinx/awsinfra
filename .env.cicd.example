# 隔离 CI/CD 验证版。复制为 .env.cicd 后填写，不要提交真实密钥。
OPS_CICD_MYSQL_PASSWORD=ops_cicd_local_password
OPS_CICD_MYSQL_ROOT_PASSWORD=ops_cicd_local_root_password
OPS_CICD_REDIS_PASSWORD=ops_cicd_local_redis_password
OPS_CICD_MYSQL_DSN=ops_cicd:ops_cicd_local_password@tcp(127.0.0.1:23306)/ops_deploy_cicd?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
OPS_CICD_PASSWORD_HASH=
# Generate once with: openssl rand -base64 32
OPS_CICD_CREDENTIAL_KEY=
