# Store this file outside the repository with mode 0600. Generate the encoded
# value with `ops-deploy hash-password`; do not place the plaintext here.
OPS_DEPLOY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$replace-salt$replace-hash'
# Must be the same 32-byte Base64 key used for every restart and restore.
OPS_DEPLOY_CREDENTIAL_KEY='replace-with-base64-32-byte-key'
OPS_MYSQL_DSN='ops_deploy:replace-password@tcp(replace-rds-endpoint:3306)/ops_deploy?parseTime=true&charset=utf8mb4&tls=true'
OPS_REDIS_PASSWORD='replace-with-a-long-random-password'
