apiVersion: v1
kind: Namespace
metadata:
  name: {{ q .Namespace }}
  labels:
    app.kubernetes.io/part-of: ops-deploy-platform
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ops-deploy-mysql-config
  namespace: {{ q .Namespace }}
data:
  platform.cnf: |
    [mysqld]
    character-set-server=utf8mb4
    collation-server=utf8mb4_unicode_ci
    default-time-zone='+00:00'
    skip-name-resolve=ON
    slow-query-log=ON
    long-query-time=2
    max-connections=300
---
apiVersion: v1
kind: Service
metadata:
  name: ops-deploy-mysql
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: ops-deploy-mysql
spec:
  selector:
    app.kubernetes.io/name: ops-deploy-mysql
  ports:
    - name: mysql
      port: 3306
      targetPort: mysql
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: ops-deploy-mysql
  namespace: {{ q .Namespace }}
spec:
  serviceName: ops-deploy-mysql
  replicas: 1
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Retain
  selector:
    matchLabels:
      app.kubernetes.io/name: ops-deploy-mysql
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ops-deploy-mysql
        app.kubernetes.io/part-of: ops-deploy-platform
    spec:
      terminationGracePeriodSeconds: 60
      securityContext:
        fsGroup: 999
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: mysql
          image: mysql:8.4@sha256:c831a0f11348d402b43d77453e17d770be2eef356615a2823fe0f5a0d6c8b9af
          imagePullPolicy: IfNotPresent
          ports:
            - name: mysql
              containerPort: 3306
          env:
            - name: MYSQL_DATABASE
              value: ops_deploy
            - name: MYSQL_USER
              value: ops
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_MYSQL_PASSWORD
            - name: MYSQL_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_MYSQL_ROOT_PASSWORD
          startupProbe:
            exec:
              command: ["sh", "-ec", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec mysql -uroot -Nse 'SELECT 1'"]
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec:
              command: ["sh", "-ec", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec mysql -uroot -Nse 'SELECT 1'"]
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          livenessProbe:
            exec:
              command: ["sh", "-ec", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec mysql -uroot -Nse 'SELECT 1'"]
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 6
          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: "2"
              memory: 4Gi
          volumeMounts:
            - name: data
              mountPath: /var/lib/mysql
            - name: config
              mountPath: /etc/mysql/conf.d/platform.cnf
              subPath: platform.cnf
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: ops-deploy-mysql-config
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ q .StorageClass }}
        resources:
          requests:
            storage: {{ q .MySQLStorage }}
---
apiVersion: v1
kind: Service
metadata:
  name: ops-deploy-redis
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: ops-deploy-redis
spec:
  selector:
    app.kubernetes.io/name: ops-deploy-redis
  ports:
    - name: redis
      port: 6379
      targetPort: redis
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: ops-deploy-redis
  namespace: {{ q .Namespace }}
spec:
  serviceName: ops-deploy-redis
  replicas: 1
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Retain
  selector:
    matchLabels:
      app.kubernetes.io/name: ops-deploy-redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ops-deploy-redis
        app.kubernetes.io/part-of: ops-deploy-platform
    spec:
      terminationGracePeriodSeconds: 30
      securityContext:
        fsGroup: 100
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: redis
          image: redis:7.4-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
          imagePullPolicy: IfNotPresent
          args: ["redis-server", "--appendonly", "yes", "--appendfsync", "everysec", "--requirepass", "$(OPS_REDIS_PASSWORD)"]
          ports:
            - name: redis
              containerPort: 6379
          env:
            - name: OPS_REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_REDIS_PASSWORD
            - name: REDISCLI_AUTH
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_REDIS_PASSWORD
          startupProbe:
            exec:
              command: ["redis-cli", "ping"]
            periodSeconds: 3
            failureThreshold: 30
          readinessProbe:
            exec:
              command: ["redis-cli", "ping"]
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          livenessProbe:
            exec:
              command: ["redis-cli", "ping"]
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 6
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
          volumeMounts:
            - name: data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ q .StorageClass }}
        resources:
          requests:
            storage: {{ q .RedisStorage }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ops-deploy-runtime
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: ops-deploy-platform
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ q .StorageClass }}
  resources:
    requests:
      storage: {{ q .PlatformStorage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ops-deploy-platform
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: ops-deploy-platform
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: ops-deploy-platform
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ops-deploy-platform
        app.kubernetes.io/part-of: ops-deploy-platform
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: initialize-runtime-volume
          image: busybox:1.37.0
          command:
            - /bin/sh
            - -ec
            - |
              mkdir -p /state/data/jobs /state/data/logs /state/environments /state/infra-state /state/platform-state
              chown -R 10001:10001 /state
              chmod 0700 /state/data /state/data/jobs /state/data/logs /state/environments /state/infra-state /state/platform-state
              find /state/data/jobs -type d -exec chmod 0700 {} \;
              find /state/data/jobs -type f -exec chmod 0600 {} \;
          securityContext:
            runAsUser: 0
            runAsNonRoot: false
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
              add: ["CHOWN", "FOWNER", "DAC_OVERRIDE"]
          volumeMounts:
            - name: runtime
              mountPath: /state
        - name: wait-for-datastores
          image: busybox:1.37.0
          command: ["sh", "-ec", "until nc -z ops-deploy-mysql 3306 && nc -z ops-deploy-redis 6379; do echo 'waiting for MySQL and Redis'; sleep 2; done"]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
      containers:
        - name: platform
          image: {{ q .Image }}
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: OPS_DEPLOY_LISTEN_ADDRESS
              value: 0.0.0.0:8080
            - name: OPS_DEPLOY_REDIS_ADDRESS
              value: ops-deploy-redis:6379
            - name: OPS_DEPLOY_COOKIE_SECURE
              value: {{ q .CookieSecure }}
            - name: OPS_DEPLOY_EXTERNAL_ORIGIN
              value: {{ q .ExternalOrigin }}
            - name: OPS_DEPLOY_PASSWORD_HASH
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_DEPLOY_PASSWORD_HASH
            - name: OPS_DEPLOY_CREDENTIAL_KEY
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_DEPLOY_CREDENTIAL_KEY
            - name: OPS_MYSQL_DSN
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_MYSQL_DSN
            - name: OPS_REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ops-deploy-secrets
                  key: OPS_REDIS_PASSWORD
            - name: HOME
              value: /app/data/home
            - name: HELM_CACHE_HOME
              value: /app/data/helm/cache
            - name: HELM_CONFIG_HOME
              value: /app/data/helm/config
            - name: HELM_DATA_HOME
              value: /app/data/helm/data
          startupProbe:
            tcpSocket:
              port: http
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            tcpSocket:
              port: http
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 6
          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: "2"
              memory: 4Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: runtime
              mountPath: /app/data
              subPath: data
            - name: runtime
              mountPath: /app/environments
              subPath: environments
            - name: runtime
              mountPath: /app/terraform/infra/terraform.tfstate.d
              subPath: infra-state
            - name: runtime
              mountPath: /app/terraform/platform/terraform.tfstate.d
              subPath: platform-state
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: runtime
          persistentVolumeClaim:
            claimName: ops-deploy-runtime
        - name: tmp
          emptyDir:
            sizeLimit: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: ops-deploy-platform
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: ops-deploy-platform
spec:
  type: {{ q .ServiceType }}
  selector:
    app.kubernetes.io/name: ops-deploy-platform
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ops-deploy-mysql-ingress
  namespace: {{ q .Namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ops-deploy-mysql
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: ops-deploy-platform
      ports:
        - protocol: TCP
          port: 3306
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ops-deploy-redis-ingress
  namespace: {{ q .Namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ops-deploy-redis
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: ops-deploy-platform
      ports:
        - protocol: TCP
          port: 6379
{{- if .IngressEnabled }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ops-deploy-platform
  namespace: {{ q .Namespace }}
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: HTTP
    higress.io/ssl-redirect: "true"
spec:
  ingressClassName: {{ q .IngressClassName }}
  tls:
    - hosts: [{{ q .IngressHost }}]
      secretName: {{ q .IngressTLSSecretName }}
  rules:
    - host: {{ q .IngressHost }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ops-deploy-platform
                port:
                  name: http
{{- end }}
