# 复制为 secrets.env 并执行 chmod 600 deploy/kubernetes/secrets.env。
# 管理员密码哈希：./bin/ops-deploy hash-password
OPS_DEPLOY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$replace-salt$replace-hash'

# 必须使用 32 字节 Base64 主密钥。迁移现有数据库时必须沿用原值，否则已有密文无法解密。
# 生成方式：openssl rand -base64 32
OPS_DEPLOY_CREDENTIAL_KEY='replace-with-base64-32-byte-key'

# 至少 16 位随机值；部署工具会在内存中生成 OPS_MYSQL_DSN，不会写回文件。
OPS_MYSQL_PASSWORD='replace-with-long-random-password'
OPS_MYSQL_ROOT_PASSWORD='replace-with-different-long-random-password'
OPS_REDIS_PASSWORD='replace-with-long-random-password'
